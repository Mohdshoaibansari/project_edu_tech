<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} — EduTech</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="text-4xl mb-3">🏫</div>
      <h1 class="text-2xl font-bold text-gray-800">EduTech Admin</h1>
      <p class="text-gray-500 text-sm mt-1">Sign in to manage your platform</p>
    </div>

    {{#if error}}
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">
      {{error}}
    </div>
    {{/if}}

    <form method="POST" action="/admin/login" class="bg-white shadow rounded-lg p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" name="email" required autofocus
               class="border rounded px-3 py-2 w-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="admin@school.edu">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input type="password" name="password" required
               class="border rounded px-3 py-2 w-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
               placeholder="••••••••">
      </div>
      <button type="submit"
              class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 text-sm font-medium">
        Sign In
      </button>
    </form>

    <p class="text-center text-xs text-gray-400 mt-6">
      &copy; {{currentYear}} EduTech Platform
    </p>
  </div>
</body>
</html>
